# Whether to stop searching upwards for `.editorconfig` files
root = true

# Sane defaults for plain text files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Deviant indent style
[{makefile,dockerfile}]
indent_style = tab

# Deviant indent size
[*.{html,xhtml,xml}]
indent_size = 2
[*.{js,jsx,ts,tsx}]
indent_size = 2
[*.{json,jsonc,yml,yaml}]
indent_size = 2

# Deviant maximum line length
[*.{bash,py,rs,sh,zsh}]
max_line_length = 79
[*.{cls,md,sty,tex}]
max_line_length = 0
